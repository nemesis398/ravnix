# claude-telemetry: read-only telemetry over Claude Code's transcripts.
# Carried over from Fedora's bin-claude-telemetry and still Python, unchanged
# but for the places it reads its folders from (AGENTS.md, rule 4); README.md
# has what changed. Stdlib only. Its systemd units are generated by
# modules/common/scripts.nix.
{ writers }:
writers.writePython3Bin "claude-telemetry"
  {
    # The original fails flake8 on these and is left as it was:
    #   E501  lines past 79 characters (157 of them)
    #   E127  one over-indented continuation line
    #   W503, W504  line breaks before and after binary operators (2 and 1),
    #         which flake8's defaults ignore both; giving an ignore list
    #         replaces the defaults
    flakeIgnore = [
      "E501"
      "E127"
      "W503"
      "W504"
    ];
  }
  (builtins.readFile ./claude-telemetry.py)
