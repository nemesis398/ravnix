# The values of docker-compose.yaml, whose header says what each one is.
# Copy this file to .env beside it, fill it in, and make it readable by its
# owner only (chmod 600 .env); keep a copy of the secrets in the password
# manager. Every required variable left empty stops `docker compose` with a
# message that names it. Compose reads $ in a value as a variable, so write
# a value that holds one in single quotes.
#
# The address and the account are your own, so this file names none.

# The NAS's LAN address, the one address the port listens on.
PAPERLESS_BIND_ADDRESS=
# Optional: the port on that address.
# PAPERLESS_PORT=8010

# The shared folder, and the NAS account that owns it and runs every service.
PAPERLESS_DATA_DIR=/volume1/paperless
PAPERLESS_UID=
PAPERLESS_GID=

# The address the family opens, and Authelia's issuer.
PAPERLESS_URL=https://paperless.example.org
PAPERLESS_OIDC_SERVER_URL=https://auth.example.org

# The secrets. Make the first two with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
# and copy the third from Authelia's client `paperless` (its rfc3986
# characters hold no " and no \, which the provider JSON could not take).
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=
PAPERLESS_OIDC_CLIENT_SECRET=

# The tag `docker load` printed for ravnix-paperless-copy-image.
PAPERLESS_ARCHIVE_COPY_IMAGE=

# Optional: Uptime Kuma push URLs; empty pushes nothing.
KUMA_PUSH_URL_PAPERLESS_EXPORT=
KUMA_PUSH_URL_PAPERLESS_COPY=
