#!/bin/sh
# The programs the tests stand in for: xdg-open, notify-send, obsidian, git
# and ravnix-notify. Each is a symlink to this file in a test's bin
# directory, beside a case.sh that says what the program does in that test.
# Every run is recorded in the directory's log: the program's name and its
# arguments, each ended by a NUL, and the run ended by a byte 1, so an
# argument may hold spaces, newlines and anything but a NUL or that byte.
# A script that is only read (case.sh) has no ETXTBSY race with a thread
# that forks while a test writes it, which an executable written and run at
# once has.
d=${0%/*}
n=${0##*/}
{
  printf '%s\000' "$n" "$@"
  printf '\001'
} >>"$d/log"
if [ -f "$d/case.sh" ]; then
  # shellcheck source=/dev/null
  . "$d/case.sh"
fi
:
