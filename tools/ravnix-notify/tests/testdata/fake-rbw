#!/bin/sh
# The rbw of the flow tests. A test writes what this rbw does into
# rbw-case.sh beside a symlink to this file and runs the symlink, so the case
# sees rbw's arguments and environment. A script that is only read has no
# ETXTBSY race with a thread that forks while a new file is still open for
# writing (see ravnix-disk-guard's fake-lsblk).
# shellcheck source=/dev/null
. "${0%/*}/rbw-case.sh"
