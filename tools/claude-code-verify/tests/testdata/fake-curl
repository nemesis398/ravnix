#!/bin/sh
# The curl of the fetch tests. A test writes what this curl does into
# case.sh beside a symlink to this file and runs the symlink, so case.sh sees
# curl's arguments. Writing an executable and running it at once fails now
# and then with ETXTBSY: while one test holds the new file open for writing,
# another test's thread forks, and the child inherits the descriptor. A
# script that is only read has no such race.
# shellcheck source=/dev/null
. "${0%/*}/case.sh"
