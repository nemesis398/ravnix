#!/usr/bin/env bash
# Waybar GPU-temperature module — amdgpu "edge" temp (temp1_input).
# Detects the amdgpu hwmon by DRIVER NAME, not a hardcoded path: the GPU's PCI
# address differs per machine (36:00.0 on this laptop's iGPU, 08:00.0 on the
# retired desktop's RX 6700 XT), so a static hwmon-path is deliberately avoided.
# Replaces the built-in temperature#gpu module for exactly that reason. Emits
# Waybar JSON with a .warning/.critical class so style.css can colour it.
set -uo pipefail

ICON="<span color='@accent@'>󱃂</span>"

# First amdgpu hwmon with a readable edge temp (the iGPU exposes one here).
temp_file=""
for h in /sys/class/hwmon/hwmon*; do
  [ "$(cat "$h/name" 2>/dev/null)" = "amdgpu" ] || continue
  [ -r "$h/temp1_input" ] && { temp_file="$h/temp1_input"; break; }
done

if [ -n "$temp_file" ]; then
  milli="$(cat "$temp_file" 2>/dev/null || echo 0)"
  case "$milli" in ""|*[!0-9]*) milli=0;; esac   # normalise empty/non-numeric to 0
  c=$(( milli / 1000 ))
else
  c=0
fi

class="gpu"
if   [ "$c" -ge 90 ]; then class="critical"
elif [ "$c" -ge 80 ]; then class="warning"
fi

jq -nc --arg t "$ICON ${c}°C" --arg cls "$class" --argjson c "$c" \
  '{text:$t, class:$cls, tooltip:("GPU temp: " + ($c|tostring) + "°C")}'
