{
  // ── The FOCUS bar ────────────────────────────────────────────────────────────
  // Distraction-light variant: the workspaces AND the whole right cluster (the
  // tray, which lives on the right, included) are removed. Kept: power draw,
  // power-mode switch, the focused-window title, and the clock. Toggle with
  // $mod+Ctrl+space. The geometry is the full bar's (docs/style.md: the bar has
  // the same height in every mode).
  "include": ["~/.config/waybar/modules.jsonc"],

  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 2,

  "modules-left": [
    "custom/battery",
    "custom/peripherals",
    "custom/powerdraw",
    "power-profiles-daemon",
    "sway/mode",
    "sway/window"
  ],
  "modules-center": [
    "custom/idle-inhibit",
    "custom/clock",
    "custom/idle-pad"
  ],
  "modules-right": []
}
